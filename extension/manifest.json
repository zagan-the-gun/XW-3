{
  "manifest_version": 3,
  "name": "出品くん Filler (XW-3)",
  "version": "1.3.1",
  "description": "XW-3 出品くんの商品データをメルカリ / Yahoo!フリマの出品フォームへ流し込みます。出品ボタンは押しません。",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8720/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jp.mercari.com/*",
        "https://paypayfleamarket.yahoo.co.jp/*"
      ],
      "js": ["lib/fill.js", "sites/mercari.js", "sites/yahoo.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "出品くん Filler"
  }
}
